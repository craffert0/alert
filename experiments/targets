import argparse
import csv
import functools
import html
import json
import os.path
import pathlib
import server
import sys
import time
from datetime import datetime
from pathlib import Path

kRegions = ["US-NY-047", "US-NY-061"]  # Brooklyn & Manhattan


def header(title):
    return f"""
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
  </head>
  <body>
"""


kTrailer = """
  </body>
</html>
"""

kTableStart = """
    <table>
      <thead>
        <th>Location</th>
        <th>Date</th>
        <th>Comment</th>
      </thead>
      <tbody>
"""

kTableEnd = """
      </tbody>
    </table>
"""


kGetParams = "&back=2&r=" + ",".join(kRegions)


def link(tag, href):
    return f'<a href="{href}">{tag}</a>'


def td(text):
    return f"<td>{text}</td>\n"


def tr(location, date, comment):
    return "<tr>" + td(location) + td(date) + td(comment) + "</tr>\n"


def load_taxonomy():
    csvf = os.path.join(
        os.path.dirname(__file__),
        "../eBirdAlert/eBirdAlert/Assets/taxonomy.csv",
    )

    with open(csvf, "r") as taxon:
        return {
            js["speciesCode"]: js
            for js in csv.DictReader(taxon, delimiter=",")
        }


class Cache:
    def __init__(self, path):
        if not path.is_dir():
            raise RuntimeError(f"{path} is not a directory")
        self.path = path

    def get(self, style, name):
        try:
            with (self.path / f"{style}.{name}.js").open() as i:
                return json.load(i)
        except:
            return None

    def put(self, style, name, value):
        with (self.path / f"{style}.{name}.js").open(mode="w") as o:
            json.dump(value, o)


class Server(server.Server):
    def __init__(self, cache):
        self.cache = cache
        super(Server, self).__init__()

    def birds(self):
        time.sleep(2)
        return self.get(f"data/obs/{kRegions[0]}/recent", kGetParams)

    def bird(self, species):
        time.sleep(2)
        return self.get(
            f"data/obs/{kRegions[0]}/recent/{species}", kGetParams
        )

    @functools.cache
    def checklist(self, subId):
        cached = self.cache.get("checklist", subId)
        if cached is not None:
            return cached
        time.sleep(2)
        value = self.get("product/checklist/view/" + subId)
        self.cache.put("checklist", subId, value)
        return value

    def checklistObs(self, subId):
        try:
            return self.checklist(subId)["obs"]
        except:
            return []


class Person:
    def __init__(self, json):
        self.name = json["name"]
        self.output = json["output"]
        self.lifers = set(json["lifers"])

    def hits(self, species):
        return species - self.lifers


class Sighting:
    def __init__(self, json, server):
        self.json = json
        obsDt = json["obsDt"]
        if len(obsDt) == 16:
            self.date = datetime.strptime(obsDt, "%Y-%m-%d %H:%M")
            self.dateName = self.date.strftime("%b&nbsp;%-d %-I:%M%p")
        else:
            self.date = datetime.strptime(obsDt, "%Y-%m-%d")
            self.dateName = self.date.strftime("%b&nbsp;%-d")
        speciesCode = json["speciesCode"]
        obses = [
            ob
            for ob in server.checklistObs(json["subId"])
            if ob["speciesCode"] == speciesCode
        ]
        if len(obses) == 1:
            self.obs = obses[0]
        else:
            self.obs = {}

    def row(self):
        if self.json["locationPrivate"]:
            href = f"https://www.google.com/maps/search/?q={self.json["lat"]},{self.json["lng"]}"
        else:
            href = f"https://ebird.org/hotspot/{self.json["locId"]}"
        comment = self.obs.get("comments", "Checklist")
        if self.obs.get("mediaCounts", {}).get("P", 0) > 0:
            comment = "📷️ " + comment
            checklist = self.json["subId"] + "?view=photos"
        else:
            checklist = self.json["subId"]
        return tr(
            link(html.escape(self.json["locName"]), href),
            self.dateName,
            link(comment, f"https://ebird.org/checklist/{checklist}"),
        )


class Species:
    def __init__(self, speciesCode, taxon, server):
        self.speciesCode = speciesCode
        self.comName = taxon["comName"]
        self.taxonOrder = taxon["taxonOrder"]
        self.sightings = sorted(
            [Sighting(x, server) for x in server.bird(speciesCode)],
            key=lambda s: s.date,
            reverse=True,
        )
        self.title = f"{self.comName} ({self.sightings[0].dateName})"


def main(args):
    updated = datetime.now().strftime("<p>Updated: %b %-d %-I%p</p>\n")
    taxonomy = load_taxonomy()
    people = [Person(x) for x in json.load(sys.stdin)["people"]]
    server = Server(Cache(args.cachedir))
    nearby = {
        s["speciesCode"] for s in server.birds() if not "exoticCategory" in s
    }
    allhits = set.union(*[p.hits(nearby) for p in people])
    allspecies = {s: Species(s, taxonomy[s], server) for s in allhits}
    for p in people:
        title = p.name.title()
        with open(p.output, "w", encoding="utf-8") as of:
            of.write(header(title))
            hits = p.hits(nearby)
            if len(hits) == 0:
                of.write(f"<h2>No Target Species Seen For {title}</h2>")
                of.write(updated)
            else:
                of.write(f"<h2>Target Species For {title}</h2>\n")
                of.write(updated)
                for species in sorted(
                    [allspecies[code] for code in hits],
                    key=lambda s: s.taxonOrder,
                ):
                    of.write(f"<details><summary>{species.title} ")
                    of.write(
                        link(
                            "eBird",
                            f"https://ebird.org/species/{species.speciesCode}",
                        )
                    )
                    of.write(" - ")
                    of.write(
                        link(
                            "Macaulay",
                            f"https://search.macaulaylibrary.org/catalog?taxonCode={species.speciesCode}",
                        )
                    )
                    of.write("</summary>\n")
                    of.write(kTableStart)
                    for sighting in species.sightings:
                        of.write(sighting.row())
                    of.write(kTableEnd)
                    of.write("</details>\n")
            of.write(kTrailer)


def parse_args():
    parser = argparse.ArgumentParser(prog="targets")
    parser.add_argument("-c", "--cachedir", type=pathlib.Path, required=True)
    return parser.parse_args(sys.argv[1:])


if __name__ == "__main__":
    main(parse_args())
