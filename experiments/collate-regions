import argparse
import json
import pathlib
import sys


def parse_args():
    parser = argparse.ArgumentParser(prog="collate-regions")
    parser.add_argument("path", type=pathlib.Path)
    return parser.parse_args(sys.argv[1:])


def load(region):
    with region.open() as ri:
        r = json.load(ri)
        subpath = region.parent / f"{region.name[:-8]}.subr.js"
        if subpath.exists():
            with subpath.open() as si:
                subregionCodes = [
                    x
                    for x in json.load(si)
                    if (region.parent / f"{x}.info.js").exists()
                ]
                if len(subregionCodes) != 0:
                    r["subregionCodes"] = subregionCodes
        return r


def dump(r):
    b = r.get("bounds", {"maxX": 0, "maxY": 0, "minX": 0, "minY": 0})
    code = r["code"]
    result = r["result"]
    latitude = r["latitude"]
    longitude = r["longitude"]
    ttype = r["type"]
    bounds_minX = b["minX"]
    bounds_maxX = b["maxX"]
    bounds_minY = b["minY"]
    bounds_maxY = b["maxY"]
    subregions = ",".join(r.get("subregionCodes", []))
    print(
        f'"{code}","{result}",{latitude:0.6f},{longitude:0.6f},"{ttype}",{bounds_minX:0.6f},{bounds_maxX:0.6f},{bounds_minY:0.6f},{bounds_maxY:0.6f},"{subregions}"'
    )


def main(args):
    print(
        "code,result,latitude,longitude,type,bounds_minX,bounds_maxX,bounds_minY,bounds_maxY,subregions"
    )
    regions = sorted(args.path.glob("*.info.js"), key=lambda f: f.name[:-8])
    for r in [load(x) for x in regions]:
        dump(r)


if __name__ == "__main__":
    main(parse_args())
